# ==============================================================================
# SupportFlow Backend — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in the values for your local environment.
# NEVER commit real credentials, tokens or secrets to version control.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-app-secret-here
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# Option 1: MySQL (Default local development)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/supportflow?charset=utf8mb4"

# Option 2: SQLite (Fast zero-setup testing without installing a database server)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Option 3: PostgreSQL (Docker compose)
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase-here
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
SESSION_MAX_LIFETIME=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
###< lexik/jwt-authentication-bundle ###
