# ==============================================================================
# SupportFlow Backend — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in the values for your local environment.
# NEVER commit real credentials, tokens or secrets to version control.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-app-secret-here
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL connection template:
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase-here
###< lexik/jwt-authentication-bundle ###
